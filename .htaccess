Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:config\.php|fix_advance\.php|chatbot\.jsx)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(?:sql|log|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:backup|docs)(?:/|$) - [F,L,NC]
    RewriteRule ^testing(?:/|$) - [F,L,NC]
    RewriteRule ^tools(?:/|$) - [F,L,NC]
    RewriteRule ^(?:Dockerfile|render\.yaml|compose\.render-test\.yml)$ - [F,L,NC]
</IfModule>
