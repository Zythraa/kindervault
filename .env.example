# KinderVault local or Render environment variables.
# Never commit a file containing real values.
APP_ENV=local
APP_DEBUG=true
SCANNER_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=kindervault
DB_USER=root
DB_PASSWORD=
DB_SSL_ENABLED=false
DB_SSL_CA=

# Base64-encoded 32-byte value. Generate with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
MFA_ENCRYPTION_KEY=

# Only needed by the local Adminer credential helper.
LOCAL_ADMINER_USERNAME=kindervault_admin
LOCAL_ADMINER_PASSWORD=
